<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="WritCrafter">
            <Action name="WRITCRAFTER_TOGGLE_QUEUE">
                <Down>WritCrafter.QueueWindow.Toggle()</Down>
            </Action>
            <Action name="WRITCRAFTER_ACCEPT_WRITS">
                <Down>WritCrafter.Rolis.AcceptCrafted(true)</Down>
            </Action>
            <Action name="WRITCRAFTER_TOGGLE_POTIONS">
                <Down>WritCrafter.PotionSearch.Toggle()</Down>
            </Action>
        </Category>
    </Layer>
</Bindings>
